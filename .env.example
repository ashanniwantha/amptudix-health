# =============================================================================
# Amptudix Health — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the blanks:
#
#     cp .env.example .env
#
# Two consumers read these values:
#   1. Docker Compose  — substitutes ${VAR} inside compose.yaml
#   2. The Go binary   — reads via os.Getenv inside the container
#
# If you also run `go run ./cmd/api` directly on the host (outside Docker),
# override hosts to localhost in your shell, e.g.:
#     REDIS_HOST=localhost DB_HOST=localhost go run ./cmd/api
# Do NOT put localhost values into .env if you also use Docker Compose —
# the Compose substitution will pick them up and the container will try
# to connect to itself.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# POSTGRES_* are consumed by the postgres container itself.
# DB_* are consumed by the Go application.
POSTGRES_USER=amptudix
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=amptudix_health
POSTGRES_HOST_PORT=5432

# DB_HOST defaults to the compose service name "postgres".
# Leave blank for Docker Compose. Set explicitly only when pointing at an
# external Postgres (managed database, staging, etc.).
DB_HOST=
DB_PORT=5432

# Connection pool tuning. Safe defaults for a single API instance.
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_CONNECT_TIMEOUT=5s
DB_PING_TIMEOUT=3s
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST_PORT=6379

# REDIS_HOST defaults to the compose service name "redis".
# Leave blank for Docker Compose. Set explicitly only for external Redis.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PING_TIMEOUT=3s

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
# Access tokens are signed with RS256 (asymmetric). No string secret is used.
# Point these at the RSA key files. Paths are relative to /app inside the
# container (they are mounted by compose.yaml).
# Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem

# sudo rm private.pem public.pem
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out private.pem
# openssl rsa -in private.pem -pubout -out public.pem
# sudo chown 65532:65532 private.pem public.pem
# sudo chmod 600 private.pem public.pem

# Required — Compose refuses to start without it.
JWT_PRIVATE_KEY_PATH=/app/private.pem
JWT_PUBLIC_KEY_PATH=/app/public.pem
JWT_EXPIRATION=15m

# -----------------------------------------------------------------------------
# Open Wearables
# -----------------------------------------------------------------------------
# API key from the Open Wearables developer portal (Settings → Credentials).
OPEN_WEARABLES_API_KEY=

# URL of the Open Wearables API as seen FROM INSIDE THE API CONTAINER.
# - Open Wearables running on the host:  http://host.docker.internal:8000
# - Open Wearables running as a sibling Compose service named "ow":  http://ow:8000
# - NEVER use http://localhost:8000 here — inside the container,
#   localhost refers to the container itself, not your host machine.
OPEN_WEARABLES_API_URL=http://host.docker.internal:8000

# SDK application credentials
# (portal → Settings → Credentials → SDK Applications).
# APP_SECRET must never be shipped to the mobile app.
APP_ID=
APP_SECRET=
